NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required for invite links (src/app/actions/admin-users.ts's inviteUser) -- the
# base URL invitees are redirected to (e.g. https://app.example.com). If unset,
# inviteUser now returns an error instead of silently sending localhost links.
NEXT_PUBLIC_SITE_URL=

# Required for the ONLYOFFICE Document Server integration (commitment document
# merge/edit/PDF export) -- the server-side base URL ONLYOFFICE runs at
# (e.g. http://localhost:8082), used to call the DocBuilder API.
ONLYOFFICE_DOCUMENT_SERVER_URL=
# Shared secret used to sign and verify JWTs exchanged with the ONLYOFFICE
# Document Server. Must match the server's own JWT secret configuration.
ONLYOFFICE_JWT_SECRET=
# Browser-facing base URL of the ONLYOFFICE Document Server (e.g.
# http://localhost:8082), used to load the editor API script client-side.
NEXT_PUBLIC_ONLYOFFICE_DOCUMENT_SERVER_URL=
